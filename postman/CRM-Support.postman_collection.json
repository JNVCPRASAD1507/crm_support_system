{
  "info": {"name":"CRM Support Management API","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable":[{"key":"baseUrl","value":"http://localhost:8000"},{"key":"token","value":""}],
  "item":[
    {"name":"Health","request":{"method":"GET","url":"{{baseUrl}}/health"}},
    {"name":"Register Customer","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"full_name\":\"Demo Customer\",\"email\":\"customer@example.com\",\"password\":\"Customer@123\",\"phone\":\"9876543210\"}"},"url":"{{baseUrl}}/auth/register"}},
    {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"admin@crm.local\",\"password\":\"Admin@123\"}"},"url":"{{baseUrl}}/auth/login"}},
    {"name":"Profile","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/auth/profile"}},
    {"name":"Tickets","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/tickets?page=1&limit=20"}},
    {"name":"Create Ticket","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"subject\":\"Payment failed\",\"description\":\"Customer cannot complete checkout\",\"priority\":\"high\"}"},"url":"{{baseUrl}}/tickets"}},
    {"name":"Dashboard Admin","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/dashboard/admin"}},
    {"name":"SLA Breached","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/sla/breached"}}
  ]
}
